{
  "excluded_legacy_relationships": [
    {
      "condition": "dpi1.BaseEntry = dln1.DocEntry AND dpi1.BaseLine = dln1.LineNum AND dpi1.BaseType = 15",
      "name": "dpi1_dln1",
      "reason": "通用领域包标记为待业务复核，运行实例保留不等于可作为模板默认。"
    },
    {
      "condition": "orct.CardCode = ocrd.CardCode",
      "name": "orct_ocrd",
      "reason": "使用含收付款类别及业务伙伴类型过滤的替代关系，避免科目类记录误用业务伙伴连接。"
    },
    {
      "condition": "orct.DocEntry = rct2.DocNum",
      "name": "orct_rct2",
      "reason": "通用领域包标记为待业务复核，运行实例保留不等于可作为模板默认。"
    },
    {
      "condition": "ovpm.CardCode = ocrd.CardCode",
      "name": "ovpm_ocrd",
      "reason": "使用含收付款类别及业务伙伴类型过滤的替代关系，避免科目类记录误用业务伙伴连接。"
    },
    {
      "condition": "ovpm.DocEntry = vpm2.DocNum",
      "name": "ovpm_vpm2",
      "reason": "通用领域包标记为待业务复核，运行实例保留不等于可作为模板默认。"
    }
  ],
  "notes": [
    "特定公司库的样本支持不能自动解除通用模板的待审状态。",
    "同表来源需要角色别名，未在模板中生成自关联。",
    "支付应用所属单据键需要DocEntry与DocNum不同的有判别力样本。",
    "库存估价来源连接、生产组件归属、成本金额与历史核销余额仍需目标库和SAP报表验收。"
  ],
