        "item_code": "订单行物料编码",
        "item_description": "订单行历史描述",
        "order_line_status": "订单行状态",
        "order_line_manual_close": "订单行手工关闭标志",
        "logistics_entry": "交货内部标识",
        "logistics_no": "交货编号",
        "logistics_line": "交货原始行号",
        "logistics_date": "交货过账日期",
        "logistics_cancellation": "交货取消状态",
        "invoice_entry": "发票内部标识",
        "invoice_no": "发票编号",
