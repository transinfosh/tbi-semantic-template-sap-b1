  "views": [
    {
      "name": "sales_order_to_cash_trace",
      "title": "销售订单到收款追溯",
      "group": "sales",
      "description": "销售订单到收款追溯：以订单原始行展开后续物流行、发票行和收款应用行的关联路径；只提供身份、日期、状态，不包含可求和的数量或金额。正常物流后开票、订单直接开票、预留发票后物流分别保留；未发生的后继为空。一张订单可分批、一发票可合并多订单、一发票可多次收款，路径数不是单据数。按order_entry/order_line定位，不按物料或显示单号猜测。取消记录保留，须按问题筛选各阶段状态。收款仅指该发票通过RCT2的明确应用，不代表全部内部核销、预付款抵扣或纯现金结清；金额查独立发票收款应用明细。没有订单来源的独立单据不属于本视图。",
      "statementFile": "sql/sales_order_to_cash_trace.sql",
      "columnTitles": {
        "path_kind": "来源路径",
        "order_entry": "订单内部标识",
        "order_no": "订单编号",
