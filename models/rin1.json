    },
    {
      "displayName": "当前行单据类型",
      "isCalculated": false,
      "isHidden": false,
      "name": "ObjType",
      "notNull": false,
      "properties": {
        "description": "所属当前单据的对象类型，不能代替 BaseType 解释来源。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/RIN1.html"
      },
