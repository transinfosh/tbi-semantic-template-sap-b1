      "properties": {
        "description": "单据行保存的物料或服务描述，反映该单据的历史内容，不能被当前物料主数据名称替代；所属 ORIN.DocType=S 的服务行可没有 ItemCode。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/RIN1.html"
      },
      "type": "VARCHAR"
    },
    {
      "displayName": "自由文本",
      "isCalculated": false,
      "isHidden": false,
      "name": "FreeTxt",
      "notNull": false,
      "properties": {
        "description": "单据行自由文本或备注。",
