      },
      "type": "VARCHAR"
    },
    {
      "displayName": "单据内部行号",
      "isCalculated": false,
      "isHidden": false,
      "name": "LineNum",
      "notNull": true,
      "properties": {
        "description": "参与复合主键及 BaseLine 来源连接；不是界面排序号 VisOrder。 行号不保证连续，不可用 API 集合数组下标重建。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/RIN1.html"
      },
      "type": "INTEGER"
    },
