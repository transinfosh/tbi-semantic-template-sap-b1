      },
      "type": "TIMESTAMP"
    },
    {
      "displayName": "所属单据内部键",
      "isCalculated": false,
      "isHidden": false,
      "name": "DocEntry",
      "notNull": true,
      "properties": {
        "description": "所属表头内部键；与 LineNum 构成本表行主键。",
