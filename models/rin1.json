    },
    {
      "displayName": "直接来源单据内部键",
      "isCalculated": false,
      "isHidden": false,
      "name": "BaseEntry",
      "notNull": false,
      "properties": {
        "description": "营销单据来源内部键；只有来源类型匹配时才连接目标 DocEntry。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/RIN1.html"
      },
      "type": "INTEGER"
    },
    {
      "displayName": "直接来源内部行号",
      "isCalculated": false,
      "isHidden": false,
      "name": "BaseLine",
      "notNull": false,
      "properties": {
        "description": "营销单据来源行号；与 BaseEntry、BaseType 组成来源三元组。 指向来源单据实际保存的 LineNum，不是来源集合的 API 数组下标或界面显示顺序。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/RIN1.html"
      },
      "type": "INTEGER"
    },
    {
      "displayName": "直接来源单据类型",
      "isCalculated": false,
      "isHidden": false,
      "name": "BaseType",
      "notNull": false,
      "properties": {
        "description": "只记录本行直接来源类型；必须与 BaseEntry、BaseLine 一起连接，不能据流程图补造直接边。 SQL 条件使用来源对象类型数字代码，不使用 API 实体名称；允许的直接来源以已声明关系为准。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/RIN1.html"
      },
      "type": "INTEGER"
    },
    {
      "displayName": "行价格币种",
      "isCalculated": false,
      "isHidden": false,
      "name": "Currency",
      "notNull": false,
      "properties": {
        "description": "本行价格的币种，用于解释 Price 等价格字段；不能据此解释 LineTotal 或 TotalSumSy，它们分别使用 OADM.MainCurncy 和 OADM.SysCurrncy。外币单据行金额 TotalFrgn 按所属 ORIN.DocCur 解释，行价格币种与单据币种须分别读取。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/RIN1.html"
      },
      "type": "VARCHAR"
    },
    {
      "displayName": "行折扣率",
      "isCalculated": false,
      "isHidden": false,
      "name": "DiscPrcnt",
      "notNull": false,
      "properties": {
        "description": "当前单据行的折扣百分比，与整单折扣分开。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/RIN1.html"
      },
      "type": "DECIMAL"
    },
    {
      "displayName": "过账日期",
      "isCalculated": false,
      "isHidden": false,
      "name": "DocDate",
      "notNull": false,
      "properties": {
        "description": "业务过账日期；与凭证日期、到期日期及创建日期分别使用。",
