{
  "columns": [
    {
      "displayName": "取消状态",
      "isCalculated": false,
      "isHidden": false,
      "name": "CANCELED",
      "notNull": false,
      "properties": {
        "description": "取消标识，仅 N=未取消、Y=被取消的预付款单据。预付款请求可取消，取消时不另建反向取消单据；预付款发票不适用此取消操作。结合 DocStatus：N/O=未取消且未结，N/C=未取消但已结；Y 表示已取消。不能把关闭、付款或抵扣当作取消。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/ODPI.html"
      },
      "type": "CHAR"
    },
    {
      "displayName": "客户编码",
      "isCalculated": false,
      "isHidden": false,
      "name": "CardCode",
      "notNull": false,
      "properties": {
        "description": "客户编码，关联客户主数据。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/ODPI.html"
      },
      "type": "VARCHAR"
    },
