      "isCalculated": false,
      "isHidden": false,
      "name": "PaidSys",
      "notNull": false,
      "properties": {
        "description": "单据当前累计已收付系统币金额，币种取 OADM.SysCurrncy；不是未付金额或指定历史期间的收付款发生额。与单据总额比较时须使用同一币种口径。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/ODPI.html"
      },
      "type": "DECIMAL"
    },
    {
      "displayName": "累计已收付金额（本币）",
      "isCalculated": false,
      "isHidden": false,
      "name": "PaidToDate",
      "notNull": false,
      "properties": {
        "description": "单据当前累计已收付本币金额，币种取 OADM.MainCurncy；不能当作指定历史期间的收付款发生额，也不是未付金额。与单据总额比较时须使用同一币种口径。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/ODPI.html"
      },
      "type": "DECIMAL"
    },
    {
      "displayName": "预付款已过账",
      "isCalculated": false,
      "isHidden": false,
      "name": "Posted",
      "notNull": false,
