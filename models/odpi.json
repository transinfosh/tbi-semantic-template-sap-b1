      "displayName": "已应用预付款（系统币）",
      "isCalculated": false,
      "isHidden": false,
      "name": "DpmApplSc",
      "notNull": false,
      "properties": {
        "description": "已应用金额的系统币口径。 币种取同一公司库 OADM.SysCurrncy，不按当前汇率重算已保存金额。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/ODPI.html"
      },
      "type": "DECIMAL"
    },
