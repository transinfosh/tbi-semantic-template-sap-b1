      },
      "type": "INTEGER"
    },
    {
      "displayName": "来源交易类型",
      "isCalculated": false,
      "isHidden": false,
      "name": "TransType",
      "notNull": false,
      "properties": {
        "description": "59收货、60发货、67调拨、162重估等；跨来源关联必须限定类型。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
