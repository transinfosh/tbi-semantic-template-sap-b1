{
  "columns": [
    {
      "displayName": "来源参考编号",
      "isCalculated": false,
      "isHidden": false,
      "name": "BASE_REF",
      "notNull": false,
      "properties": {
        "description": "参考编号，不声明其全局唯一。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "VARCHAR(11)"
    },
    {
      "displayName": "交易估价方法",
      "isCalculated": false,
      "isHidden": false,
      "name": "CostMethod",
      "notNull": false,
      "properties": {
        "description": "A移动平均、S标准、F先进先出、B批序列、N无；历史交易方法可能不同于当前物料配置。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "VARCHAR(1)"
    },
    {
      "displayName": "创建日期",
      "isCalculated": false,
      "isHidden": false,
      "name": "CreateDate",
      "notNull": false,
      "properties": {
        "description": "系统创建日期；追溯估价时需与过账日期分别解释。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "TIMESTAMP"
    },
    {
      "displayName": "来源单据内部标识",
      "isCalculated": false,
      "isHidden": false,
      "name": "CreatedBy",
      "notNull": false,
      "properties": {
        "description": "不是创建用户；与TransType、DocLineNum共同定位来源单据行。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "INTEGER"
    },
    {
      "displayName": "原始价格币种",
      "isCalculated": false,
      "isHidden": false,
      "name": "Currency",
      "notNull": false,
      "properties": {
        "description": "官方定义为Price Currency，仅解释原始价格；不是SumStock库存过账金额的币种标签。库存本币金额用公司OADM.MainCurncy解释，系统币和外币另行核对，不按本字段对库存金额分币种或换汇。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "VARCHAR(3)"
    },
    {
      "displayName": "过账日期",
      "isCalculated": false,
      "isHidden": false,
      "name": "DocDate",
      "notNull": false,
      "properties": {
        "description": "库存交易过账日期。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "TIMESTAMP"
    },
    {
      "displayName": "来源单据行号",
      "isCalculated": false,
      "isHidden": false,
      "name": "DocLineNum",
      "notNull": false,
      "properties": {
        "description": "关联来源单据LineNum；不要改用SubLineNum或来源单据的BaseLine。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "INTEGER"
    },
    {
      "displayName": "入库数量",
      "isCalculated": false,
      "isHidden": false,
      "name": "InQty",
      "notNull": false,
      "properties": {
        "description": "本交易入库方向数量；关联IVL1前应固定交易粒度。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "DECIMAL(19,6)"
    },
    {
      "displayName": "库存科目",
      "isCalculated": false,
      "isHidden": false,
      "name": "InvntAct",
      "notNull": false,
      "properties": {
        "description": "库存估价交易的库存科目，官方关联OACT。对账时先按完整来源单据及本库存科目聚合估价金额，再与该单据TransId对应的JDT1.Account借贷净额比较；不能把单一工单子集对整张多工单凭证。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "VARCHAR(15)"
    },
    {
      "displayName": "物料编码",
      "isCalculated": false,
      "isHidden": false,
      "name": "ItemCode",
      "notNull": false,
      "properties": {
        "description": "用于物料维度，不足以证明交易属于特定工单。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "VARCHAR(50)"
    },
    {
      "displayName": "仓库编码",
      "isCalculated": false,
      "isHidden": false,
      "name": "LocCode",
      "notNull": false,
      "properties": {
        "description": "估价交易所在仓库代码；调拨存在仓库方向。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "VARCHAR(8)"
    },
    {
      "displayName": "位置类型",
      "isCalculated": false,
      "isHidden": false,
      "name": "LocType",
      "notNull": false,
      "properties": {
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "INTEGER"
    },
    {
      "displayName": "库存日志消息标识",
      "isCalculated": false,
      "isHidden": false,
      "name": "MessageID",
      "notNull": false,
      "properties": {
        "description": "关联OILM.MessageID，不能当OITL.LogEntry。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "INTEGER"
    },
    {
      "displayName": "未结数量",
      "isCalculated": false,
      "isHidden": false,
      "name": "OpenQty",
      "notNull": false,
      "properties": {
        "description": "当前未结数量字段，不等同交易发生数量或任意历史余额。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "DECIMAL(19,6)"
    },
    {
      "displayName": "出库数量",
      "isCalculated": false,
      "isHidden": false,
      "name": "OutQty",
      "notNull": false,
      "properties": {
        "description": "本交易出库方向数量；净变化候选为入减出，需按交易范围验证。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "DECIMAL(19,6)"
    },
    {
      "displayName": "库存交易原始价格",
      "isCalculated": false,
      "isHidden": false,
      "name": "Price",
      "notNull": false,
      "properties": {
        "description": "官方Price，币种上下文为Currency。与单据行StockPrice、层CalcPrice和按库存数量折算的过账单价分开；本字段乘数量不能保证还原全部已存会计金额。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "DECIMAL(19,6)"
    },
    {
      "displayName": "流水汇率字段",
      "isCalculated": false,
      "isHidden": false,
      "name": "Rate",
      "notNull": false,
      "properties": {
        "description": "与价格币种配套，不凭名称猜测换算方向。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "DECIMAL(19,6)"
    },
    {
      "displayName": "交易子行号",
      "isCalculated": false,
      "isHidden": false,
      "name": "SubLineNum",
      "notNull": false,
      "properties": {
        "description": "流水子行信息，不是来源单据行号。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "INTEGER"
    },
    {
      "displayName": "库存价值变动金额",
      "isCalculated": false,
      "isHidden": false,
      "name": "SumStock",
      "notNull": false,
      "properties": {
        "description": "官方Sum Stock Value。保留库存变动符号：库存增加为正、减少为负；常规生产发料正向成本可明确取负值，不使用ABS抹去冲回。按本币OADM.MainCurncy解释并与目标库估价层及库存科目过账核对；不可与IGE1.StockValue总销货成本值混同。NULL保持未知，缺估价行不自动补零或回退单据金额。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "DECIMAL(19,6)"
    },
    {
      "displayName": "库存估价交易序号",
      "isCalculated": false,
      "isHidden": false,
      "name": "TransSeq",
      "notNull": true,
      "properties": {
        "description": "库存估价交易唯一标识，只标识交易，不标识估价层。COUNT(TransSeq)得到交易数；一条交易仍可对应多条 IVL1 估价层记录，不能据此判断只有一层或未发生分层。层记录按 IVL1.TransSeq+LayerID 区分；只有需要判断层数或层成本时才按该完整键读取，不把交易数称为层数。不能用单据号、物料或单据行组合替代本交易主键。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "INTEGER"
    },
    {
      "displayName": "来源交易类型",
      "isCalculated": false,
      "isHidden": false,
      "name": "TransType",
      "notNull": false,
      "properties": {
        "description": "59收货、60发货、67调拨、162重估等；跨来源关联必须限定类型。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "INTEGER"
    },
    {
      "displayName": "在制品库存科目",
      "isCalculated": false,
      "isHidden": false,
      "name": "WipAct",
      "notNull": false,
      "properties": {
        "description": "官方WIP Inventory Account；与库存科目InvntAct及在制品差异科目区分，不凭名称将所有分录都当作材料发料金额。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "VARCHAR(15)"
    },
    {
      "displayName": "在制品库存价值",
      "isCalculated": false,
      "isHidden": false,
      "name": "WipVal",
      "notNull": false,
      "properties": {
        "description": "官方WIP Inventory Value；与SumStock库存价值变动分别保留，用于目标生产业务的在制品过账核对，不自动定义为本期发料成本或最终工单成本。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "DECIMAL(19,6)"
    },
    {
      "name": "PostStatus",
      "isCalculated": false,
      "isHidden": false,
      "notNull": false,
      "properties": {
        "description": "N无、P部分、C完成；保留状态，不能未经报表口径确认就默认只取C。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
      },
      "type": "CHAR(1)",
      "displayName": "估价过账状态"
    }
  ],
  "displayName": "库存估价交易流水",
  "group": "inventory",
  "name": "oivl",
  "primaryKey": "TransSeq",
  "properties": {
    "description": "每个TransSeq一条估价交易；TransType=60时用CreatedBy、DocLineNum追溯IGE1.DocEntry、LineNum，同一来源行可有多条交易。先按TransSeq聚合IVL1层，再按来源行聚合，避免复制交易数量和金额。无估价、NULL估价金额和已确认零值分别保留；生产发料库存价值减少通常为负，正向发料成本明确取负值，不用ABS吞掉冲回方向。",
    "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OIVL.html"
  },
  "tableReference": {
    "schema": "dbo",
    "table": "OIVL"
  },
  "uniqueKeys": []
}
