      "isHidden": false,
      "name": "PriceType",
      "notNull": false,
      "properties": {
        "description": "数据库代码 I=库存单位价格、P=计价单位价格、M=两者、O=其他单位价格；结合 UomEntry 与 Currency 解释 Price，不据此扩展完整定价规则。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/ITM1.html"
