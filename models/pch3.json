{
  "name": "pch3",
  "displayName": "应付发票附加费用",
  "group": "purchasing",
  "primaryKey": [
    "DocEntry",
    "LineNum"
  ],
  "uniqueKeys": [],
  "properties": {
    "description": "每条整单费用记录一行；DocEntry+LineNum为键，LineNum不是商品行号，ExpnsCode可重复。按费用自身粒度与币种计量，不与商品行展开累计或再次加到单据总额。不是落地成本分摊或库存估价。",
    "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKhelp/PCH3.html"
  },
  "tableReference": {
    "schema": "dbo",
    "table": "PCH3"
  },
  "columns": [
    {
      "name": "DocEntry",
      "isCalculated": false,
      "isHidden": false,
      "notNull": true,
      "properties": {
        "description": "费用所属单据的内部键；不能用DocNum显示单号替代。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKhelp/PCH3.html"
      },
      "type": "INTEGER",
      "displayName": "所属单据内部键"
    },
    {
      "name": "LineNum",
      "isCalculated": false,
      "isHidden": false,
      "notNull": true,
      "properties": {
        "description": "费用记录行号，与DocEntry构成复合键；不是商品行号，费用类型可以重复。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKhelp/PCH3.html"
      },
      "type": "INTEGER",
      "displayName": "费用记录行号"
    },
    {
      "name": "ExpnsCode",
      "isCalculated": false,
      "isHidden": false,
      "notNull": false,
      "properties": {
        "description": "费用类型代码，关联已有OEXD；不是费用记录主键。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKhelp/PCH3.html"
      },
      "type": "INTEGER",
      "displayName": "附加费用类型代码"
    },
    {
      "name": "ObjType",
      "isCalculated": false,
      "isHidden": false,
      "notNull": false,
      "properties": {
        "description": "所属当前单据的对象类型；不是来源单据类型BaseType。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKhelp/PCH3.html"
      },
      "type": "VARCHAR",
      "displayName": "单据对象类型"
    },
    {
      "name": "LineTotal",
      "isCalculated": false,
      "isHidden": false,
      "notNull": false,
      "properties": {
        "description": "本抵扣或费用记录保存净额，按本记录粒度和对应币种使用；不得与商品行展开或再次加到单据总额。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKhelp/PCH3.html"
      },
      "type": "DECIMAL",
      "displayName": "本记录净额（本币）"
    },
    {
      "name": "TotalFrgn",
      "isCalculated": false,
      "isHidden": false,
      "notNull": false,
      "properties": {
        "description": "本抵扣或费用记录保存净额，按本记录粒度和对应币种使用；不得与商品行展开或再次加到单据总额。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKhelp/PCH3.html"
      },
      "type": "DECIMAL",
      "displayName": "本记录净额（外币）"
    },
    {
      "name": "TotalSumSy",
      "isCalculated": false,
      "isHidden": false,
      "notNull": false,
      "properties": {
        "description": "本抵扣或费用记录保存净额，按本记录粒度和对应币种使用；不得与商品行展开或再次加到单据总额。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKhelp/PCH3.html"
      },
      "type": "DECIMAL",
      "displayName": "本记录净额（系统币）"
    },
    {
