  "primaryKey": [
    "DocEntry",
    "LineNum"
  ],
  "uniqueKeys": [],
  "tableReference": {
    "schema": "dbo",
    "table": "RIN3"
  },
  "properties": {
    "description": "ORIN 的整单附加费用记录，按 DocEntry + LineNum 计量；LineNum 不是物料行号。费用类型关联共享 OEXD；金额是单据向客户列示的费用，不是物流供应商实际成本。头金额在多条费用记录下重复；不将费用与头总额或行分摊额重复相加，也不与整单全部物料行直接展开求和。本币取同一公司库 OADM.MainCurncy，系统币取 OADM.SysCurrncy，适用外币取所属单据 DocCur；不同币种分别汇总。贷项方向和取消范围按所属单据保留，不默认取负或 ABS。",
    "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/RIN3.html"
  }
}
