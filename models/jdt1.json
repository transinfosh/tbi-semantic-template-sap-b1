      "isHidden": false,
      "name": "DebCred",
      "notNull": false,
      "properties": {
        "description": "D借方、C贷方方向标记；Debit/Credit等字段已经区分借贷侧并保存符号，不据此再次翻转金额。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/JDT1.html"
