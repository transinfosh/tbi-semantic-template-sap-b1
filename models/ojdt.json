      },
      "type": "INTEGER"
    },
    {
      "displayName": "分录系统币总额",
      "isCalculated": false,
      "isHidden": false,
      "name": "SysTotal",
      "notNull": false,
      "properties": {
        "description": "分录表头系统币总额，币种来自同公司OADM.SysCurrncy；保持头粒度，不在头行连接后重复累计。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "DECIMAL(19,6)"
    },
    {
      "displayName": "单据日期",
      "isCalculated": false,
      "isHidden": false,
      "name": "TaxDate",
      "notNull": false,
      "properties": {
        "description": "表头单据日期，不是过账日期的别名；行单据日期另见JDT1.TaxDate。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "TIMESTAMP"
    },
    {
      "displayName": "交易代码",
      "isCalculated": false,
      "isHidden": false,
      "name": "TransCode",
      "notNull": false,
      "properties": {
        "description": "用户定义分类代码；不同于来源对象类型TransType。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "VARCHAR(4)"
    },
    {
      "displayName": "交易币种",
      "isCalculated": false,
      "isHidden": false,
      "name": "TransCurr",
      "notNull": false,
      "properties": {
        "description": "分录头交易币种标识；不能无条件替代JDT1.FCCurrency的行外币，也不能从它推定整张分录只有一种外币。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "VARCHAR(3)"
    },
    {
      "displayName": "分录内部编号",
      "isCalculated": false,
      "isHidden": false,
      "name": "TransId",
      "notNull": true,
      "properties": {
        "description": "分录内部主键，供JDT1.TransId及来源业务单据的TransId连接；不是来源单据DocEntry，也不是显示编号Number。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "INTEGER"
    },
    {
      "displayName": "来源对象类型",
      "isCalculated": false,
      "isHidden": false,
      "name": "TransType",
      "notNull": false,
      "properties": {
        "description": "字符串来源对象类型，例如13应收发票、18应付发票、24收款、46付款、30日记账分录。30不证明由用户手工录入，API也可创建；结合CreatedBy追溯来源。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "VARCHAR(20)"
    },
    {
      "displayName": "更新日期",
      "isCalculated": false,
      "isHidden": false,
      "name": "UpdateDate",
      "notNull": false,
      "properties": {
        "description": "系统记录更新日。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "TIMESTAMP"
    }
  ],
  "displayName": "日记账分录表头",
  "name": "ojdt",
  "primaryKey": "TransId",
  "properties": {
    "description": "每行一个已过账日记账分录，主键TransId，Series+Number为另一唯一键。头金额和项目与JDT1行粒度分别保存；连接多行后不能重复累计头金额。反转设置不证明已执行，不按摘要或来源类型猜取消状态。",
    "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
  },
  "tableReference": {
    "schema": "dbo",
    "table": "OJDT"
  },
  "uniqueKeys": [
    [
      "Series",
      "Number"
    ]
  ]
}
