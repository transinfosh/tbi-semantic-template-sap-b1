      },
      "type": "TIMESTAMP"
    },
    {
      "displayName": "来源对象内部标识",
      "isCalculated": false,
      "isHidden": false,
      "name": "CreatedBy",
      "notNull": false,
      "properties": {
        "description": "必须结合TransType解释；不得跨对象类型直接关联DocEntry。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "INTEGER"
    },
    {
      "displayName": "到期日期",
      "isCalculated": false,
      "isHidden": false,
      "name": "DueDate",
      "notNull": false,
      "properties": {
        "description": "表头到期日期；按到期日分析分录行或分期时须读取对应行日期，不用它替代过账日。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "TIMESTAMP"
    },
    {
      "displayName": "分录外币总额",
      "isCalculated": false,
      "isHidden": false,
      "name": "FcTotal",
      "notNull": false,
      "properties": {
        "description": "分录表头外币总额；具体币种与多币分录适用性须结合该分录核实，不无条件给每条JDT1行赋同一外币；保持头粒度。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
