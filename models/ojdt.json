      },
      "type": "VARCHAR(11)"
    },
    {
      "displayName": "创建日期",
      "isCalculated": false,
      "isHidden": false,
      "name": "CreateDate",
      "notNull": false,
      "properties": {
        "description": "系统记录创建日，不是业务过账日。",
