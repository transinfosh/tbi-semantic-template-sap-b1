      "notNull": false,
      "properties": {
        "description": "过账期间内部键。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "INTEGER"
    },
    {
      "displayName": "凭证参考标识",
      "isCalculated": false,
      "isHidden": false,
