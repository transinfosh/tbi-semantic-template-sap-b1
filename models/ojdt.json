      },
      "type": "VARCHAR(2)"
    },
    {
      "displayName": "分录本币总额",
      "isCalculated": false,
      "isHidden": false,
      "name": "LocTotal",
      "notNull": false,
      "properties": {
        "description": "分录表头本币总额，币种来自同公司OADM.MainCurncy；保持头粒度，不在连接JDT1后重复求和，也不与行借贷发生额混加。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "DECIMAL(19,6)"
    },
    {
      "displayName": "分录摘要",
      "isCalculated": false,
      "isHidden": false,
      "name": "Memo",
      "notNull": false,
      "properties": {
        "description": "文字说明，不能作为稳定关联键。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
