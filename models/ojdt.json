    },
    {
      "displayName": "冲销日期",
      "isCalculated": false,
      "isHidden": false,
      "name": "StornoDate",
      "notNull": false,
      "properties": {
        "description": "DI指定创建反向交易的日期；不能仅由该日期判断冲销已经执行。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "TIMESTAMP"
    },
    {
      "displayName": "反转关联分录编号",
      "isCalculated": false,
      "isHidden": false,
      "name": "StornoToTr",
      "notNull": false,
      "properties": {
        "description": "冲销关联值；方向与有效值须按现场样本核验。",
