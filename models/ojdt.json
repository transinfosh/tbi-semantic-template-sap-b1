        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "VARCHAR(200)"
    },
    {
      "displayName": "第三参考文本",
      "isCalculated": false,
      "isHidden": false,
      "name": "Ref3",
      "notNull": false,
      "properties": {
        "description": "分录头第三参考文本；值受参考字段映射配置影响，不固定解释为发票号、订单号或分期号，不作稳定关联键。数据库定义200字符，旧DI属性长度文案不作为本模型截断规则。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "VARCHAR(200)"
    },
    {
      "displayName": "过账日期",
      "isCalculated": false,
      "isHidden": false,
      "name": "RefDate",
      "notNull": false,
      "properties": {
        "description": "表头过账日期，与TaxDate单据日期、DueDate到期日、CreateDate创建日分开；行日期另见JDT1。",
