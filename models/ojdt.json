    },
    {
      "displayName": "自动反转标记",
      "isCalculated": false,
      "isHidden": false,
      "name": "AutoStorno",
      "notNull": false,
      "properties": {
        "description": "Y/N自动反转设置；DI说明在StornoDate创建反向交易，不等于已经完成冲销。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/OJDT.html"
      },
      "type": "CHAR(1)"
    },
    {
      "displayName": "来源单据显示号",
      "isCalculated": false,
      "isHidden": false,
      "name": "BaseRef",
