      "name": "TotalSumSy",
      "notNull": false,
      "properties": {
        "description": "单据行系统币金额；不要与本币、外币金额混合。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/IGE1.html"
      },
      "type": "DECIMAL(19,6)"
    },
    {
      "displayName": "计量单位名称",
      "isCalculated": false,
      "isHidden": false,
      "name": "unitMsr",
      "notNull": false,
      "properties": {
        "description": "本行保存的计量单位名称，用于Quantity。UseBaseUn=Y且NumPerMsr=1时，也可作为该行库存数量InvQty的历史单位名称；单位非空才可标注。单位名称或缩写没有统一的物理含义，未取得单位定义或工作区确认映射时须原样显示，不能自行翻译、展开或换算。当前OITM名称不能覆盖历史；UseBaseUn=N时不能直接当库存单位。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/IGE1.html"
      },
      "type": "VARCHAR(100)"
    },
