      },
      "type": "INTEGER"
    },
    {
      "displayName": "行状态",
      "isCalculated": false,
      "isHidden": false,
      "name": "LineStatus",
      "notNull": false,
      "properties": {
        "description": "O=未清；C=关闭。关闭与取消含义不同；按业务问题显式处理，不能混合有效与取消单据。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/IGE1.html"
      },
      "type": "CHAR(1)"
    },
    {
      "displayName": "单据行不含税金额",
      "isCalculated": false,
      "isHidden": false,
      "name": "LineTotal",
      "notNull": false,
      "properties": {
        "description": "DI API定义为本行不含税金额；与StockSum、StockValue和估价过账金额各有职责。某些发料行数值相等不构成通用恒等式，不能用Quantity乘价格或LineTotal代替已存过账金额。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/IGE1.html"
      },
      "type": "DECIMAL(19,6)"
    },
    {
      "displayName": "单位换算数量",
      "isCalculated": false,
      "isHidden": false,
      "name": "NumPerMsr",
      "notNull": false,
      "properties": {
        "description": "DI API定义为每个计量单位包含的物料数量，与unitMsr及UseBaseUn配套；保留历史单据值，不用现行主数据比例覆盖。",
        "sap_b1_source": "https://help.sap.com/doc/089315d8d0f8475a9fc84fb919b501a3/10.0/en-US/SDKHelp/IGE1.html"
      },
      "type": "DECIMAL(19,6)"
    },
    {
